# =====================================================================
#  코어키퍼 서버 설정
#  주석은 ck apply 가 "무엇이 바뀌었는지" 디스코드로 알릴 때
#  사람이 읽을 이름으로 그대로 쓰입니다. 지우지 마세요.
#  값을 바꾼 뒤에는 반드시  ck apply
# =====================================================================

# ---------------------------------------------------------------- 월드
# 월드 이름 — 디스코드 알림에 표시됩니다
WORLD_NAME=__WORLD_NAME__
# 월드 슬롯 번호 — 바꾸면 다른 월드로 시작 (기존 월드는 남아 있음)
WORLD_INDEX=0
# 월드 시드 — 비우면 무작위
WORLD_SEED=
# 월드 모드 — 0:일반 1:하드 2:크리에이티브 4:캐주얼
WORLD_MODE=__WORLD_MODE__
# 최대 인원
MAX_PLAYERS=__MAX_PLAYERS__

# ---------------------------------------------------------------- 접속
# 직접 접속 포트 (UDP) — 값이 있으면 IP 직접 접속, 비우면 게임 ID 접속
SERVER_PORT=__SERVER_PORT__
# 직접 접속 비밀번호 — 최대 28자
PASSWORD=__PASSWORD__

# ---------------------------------------------------------------- 실행
# 파일 소유자 UID — 설치 시 자동으로 채워집니다
PUID=__PUID__
# 파일 소유자 GID
PGID=__PGID__
# 시작할 때 업데이트 확인 — true 면 업데이트 허가가 있을 때만 확인 (평소 재시작이 빨라짐)
UPDATE_GATE_ENABLED=true

# ---------------------------------------------------------------- 모드
# 모드 사용 — mod.io 에서 받아옵니다
MODS_ENABLED=__MODS_ENABLED__
# mod.io API 키
MODIO_API_KEY=__MODIO_API_KEY__
# mod.io API 주소
MODIO_API_URL=__MODIO_API_URL__
# 서버에 설치할 모드 목록 — mod.io 주소 마지막 부분, 쉼표로 구분
MODS=__MODS__

# ------------------------------------------------------------ 디스코드
# 디스코드 웹후크 주소 — 비우면 알림 없음
DISCORD_WEBHOOK_URL=__DISCORD_WEBHOOK__
# 접속 알림 — 잦아서 기본 꺼짐
DISCORD_PLAYER_JOIN_ENABLED=false
# 퇴장 알림 — 잦아서 기본 꺼짐
DISCORD_PLAYER_LEAVE_ENABLED=false
# 서버 시작 알림
DISCORD_SERVER_START_ENABLED=true
# 서버 시작 알림 제목
DISCORD_SERVER_START_TITLE=🟢 서버 시작
# 서버 종료 알림
DISCORD_SERVER_STOP_ENABLED=true
# 서버 종료 알림 제목
DISCORD_SERVER_STOP_TITLE=🔴 서버 종료
# 접속 알림 제목
DISCORD_PLAYER_JOIN_TITLE=👋 입장
# 퇴장 알림 제목
DISCORD_PLAYER_LEAVE_TITLE=🚪 퇴장
